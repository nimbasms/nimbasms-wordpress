<?xml version="1.0"?>
<ruleset name="NimbaSMS">
    <description>Coding standards for the Nimba SMS WordPress plugin.</description>
    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg value="ps"/>
    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="nimbasms"/>
            </property>
        </properties>
    </rule>
</ruleset>
